{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "id": "https://rdc.nii.ac.jp/schemas/rags-application/1.0.json",
  "type": "object",
  "required": ["resource_type", "callback_url", "madmp_ref", "applicant", "requests", "purpose", "evidence"],
  "properties": {
    "resource_type": {"enum": ["dataset", "facility", "compute"]},
    "callback_url": {"type": "string"},
    "madmp_ref": {
      "type": "object",
      "required": ["dmp_id"],
      "properties": {
        "dmp_id": {"$ref": "#/definitions/typed_id"},
        "dg_record_url": {"type": ["string", "null"]}
      }
    },
    "applicant": {
      "type": "object",
      "required": ["researcher", "agent"],
      "properties": {
        "researcher": {
          "type": "object",
          "required": ["name", "affiliation"],
          "properties": {
            "name": {"type": "string"},
            "orcid": {"type": ["string", "null"]},
            "eppn": {"type": ["string", "null"]},
            "affiliation": {
              "type": "object",
              "properties": {
                "name": {"type": "string"},
                "ror": {"type": ["string", "null"]}
              }
            }
          }
        },
        "agent": {
          "type": "object",
          "required": ["entity_id", "software"],
          "properties": {
            "entity_id": {"type": "string"},
            "software": {
              "type": "object",
              "properties": {
                "name": {"type": "string"},
                "version": {"type": "string"}
              }
            }
          }
        }
      }
    },
    "requests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["odrl_request"],
        "properties": {
          "dataset_id": {"type": "string"},
          "resource_id": {"type": "string"},
          "odrl_request": {"type": "object"}
        }
      }
    },
    "purpose": {
      "type": "object",
      "required": ["duo_codes", "description", "period"],
      "properties": {
        "duo_codes": {
          "type": "array",
          "items": {"type": "string", "pattern": "^DUO:[0-9]{7}$"}
        },
        "description": {"type": "string", "maxLength": 4000},
        "project_title": {"type": "string"},
        "period": {
          "type": "object",
          "properties": {
            "start": {"type": "string"},
            "end": {"type": "string"}
          }
        }
      }
    },
    "evidence": {
      "type": "object",
      "required": ["passport"],
      "properties": {
        "passport": {"type": "string"},
        "ethics_approval": {"type": ["object", "null"]},
        "security_measures": {"type": "object"}
      }
    },
    "message": {"type": ["string", "null"], "maxLength": 2000}
  },
  "definitions": {
    "typed_id": {
      "type": "object",
      "required": ["identifier", "type"],
      "properties": {
        "identifier": {"type": "string"},
        "type": {"enum": ["doi", "handle", "url", "other"]}
      }
    }
  }
}
